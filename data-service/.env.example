# Where it listens. On AWS: the instance's private IP (never 0.0.0.0). Defaults to 127.0.0.1 and 8090
# DATA_SERVICE_HOST=""
# DATA_SERVICE_PORT="8090"

# Checks the player the chess server forwards (access token or guest cookie). The same value as JWT_SECRET in server/.env
JWT_SECRET=""

# Signs every request the chess server makes (the same value goes in server/.env), at least 32 characters.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DATA_SERVICE_SECRET=""
# Optional, only while changing the secret: the old one is still accepted (README -> Data service)
# DATA_SERVICE_SECRET_OLD=""

# Optional, the region the DynamoDB tables are in (defaults to us-west-2)
# DYNAMODB_REGION=""
