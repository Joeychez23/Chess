# Where it listens. On AWS: the instance's private IP (never 0.0.0.0). Defaults to 127.0.0.1 and 8090
# DATA_SERVICE_HOST=""
# DATA_SERVICE_PORT="8090"

# Signs every session & guest token (#252), only this service has it. A P-256 private key, multi-line in double quotes.
# Make it on this machine (README -> Making the session keys), its public half goes in server/.env as SESSION_PUBLIC_KEY
SESSION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# Optional, only while the key is being changed: the old public key, so tokens signed before the change still work
# SESSION_PUBLIC_KEY_OLD=""
# Optional, how long the tokens last
# JWT_EXPIRES_IN="15m"
# JWT_REFRESH_EXPIRES_IN="7d"

# Auth0, to check the id_token a login sends: the same values as server/.env
AUTH0_ISSUER_BASE_URL_ORIGIN="your-tenant.us.auth0.com"
AUTH0_CLIENT_ID=""
# Optional, Auth0's public keys saved from https://<tenant>/.well-known/jwks.json (README -> Saving Auth0's keys).
# Defaults to auth0-jwks.json in this folder
# AUTH0_JWKS_FILE=""

# Signs every request the chess server makes (the same value goes in server/.env), at least 32 characters.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DATA_SERVICE_SECRET=""
# Optional, only while changing the secret: the old one is still accepted (README -> Data service)
# DATA_SERVICE_SECRET_OLD=""

# Optional, the region the DynamoDB tables are in (defaults to us-west-2)
# DYNAMODB_REGION=""
