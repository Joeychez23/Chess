API_PORT=3001

# Auth0 app (login + Management API "read:users")
AUTH0_ISSUER_BASE_URL_ORIGIN="your-tenant.us.auth0.com"
AUTH0_CONNECTION="auth0-default-connection"
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""

# Optional, defaults to http://localhost:API_PORT/api/auth/callback and http://localhost:API_PORT/
# AUTH0_CALLBACK_URL="http://localhost:3001/api/auth/callback"
# CLIENT_URL="http://localhost:3001/"

# Checks the session & guest tokens the data service signs (#252). Only the PUBLIC half of its key goes here,
# multi-line in double quotes (README -> Making the session keys). This server can check a token but never make one
SESSION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
# Optional, only while the key is being changed: the new public key is accepted too (README -> Changing the session key)
# SESSION_PUBLIC_KEY_NEXT=""

# Optional, where the client loads its sprites, sounds and favicons, the same value as client/.env.
# The Content-Security-Policy allows it (defaults to https://assets.chess.aws-prac-route53.com)
# CHESS_ASSETS_URL=""

# Optional, the Stockfish engine API the AI asks for its moves (defaults to https://engine.aws-prac-route53.com/v1)
# On the EC2 instance the engine runs next to this server: ENGINE_URL="http://127.0.0.1:3001/v1" (and API_PORT=8080)
# ENGINE_URL=""

# The data service (data-service/), every read and write of the games and players goes through it.
# Optional, defaults to http://127.0.0.1:8090 (npm run dev in data-service). On AWS: http://<its private IP>:8090
# DATA_SERVICE_URL=""
# Signs every call, the same value as DATA_SERVICE_SECRET in data-service/.env, at least 32 characters.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DATA_SERVICE_SECRET=""
